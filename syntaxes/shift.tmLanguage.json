{
  "name": "Shift",
  "scopeName": "source.shift",
  "patterns": [
    {
      "match": "\\b(create\\.var|create\\.asm)\\b",
      "name": "keyword.control.shift"
    },
    {
      "match": "\\.([a-zA-Z_][a-zA-Z0-9_]*)",
      "name": "entity.other.attribute-name.shift"
    },
    {
      "match": ";|:",
      "name": "punctuation.terminator.shift"
    }
  ]
}
