{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Shift",
  "scopeName": "source.shift",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#functions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.shift",
          "match": "//.*$"
        },
        {
          "name": "comment.block.shift",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.shift",
          "match": "\\b(if|else|switch|case|for|while|return|break|continue|defer|guard|async|await)\\b"
        },
        {
          "name": "keyword.declaration.shift",
          "match": "\\b(var|let|func|asm|type|enum|struct|import|ui)\\b"
        },
        {
          "name": "storage.modifier.shift",
          "match": "\\b(mutating|volatile|static|private|public|const|atomic|extern|align|cast|sizeOf|unsafe)\\b"
        },
        {
          "name": "constant.language.shift",
          "match": "\\b(true|false|nil)\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.shift",
          "match": "\\.[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.shift",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.decimal.shift",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.shift",
          "begin": "\"",
          "end": "\""
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "entity.name.function.shift"
            }
          }
        }
      ]
    }
  }
}
